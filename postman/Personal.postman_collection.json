{
  "info": {
    "name": "Ugartino - Personal (tabla maestra)",
    "description": "CRUD del personal con eliminación y restauración lógicas. Ejecuta primero 'Login administrador': guarda el token en la variable {{token}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api" },
    { "key": "token", "value": "" },
    { "key": "personalId", "value": "" },
    { "key": "dni", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Login administrador",
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/login",
        "body": { "mode": "raw", "raw": "{\n  \"perfil\": \"administrador\",\n  \"correo\": \"admin@ie20191.edu.pe\",\n  \"contrasena\": \"123456\"\n}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('200 y token', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().token).to.be.a('string'); });",
        "pm.collectionVariables.set('token', pm.response.json().token);"
      ] } }]
    },
    {
      "name": "POST Crear personal",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/personal",
        "body": { "mode": "raw", "raw": "{\n  \"nombres\": \"Rosa María\",\n  \"apellidos\": \"Quispe Torres\",\n  \"dni\": \"{{dni}}\",\n  \"cargo\": \"Auxiliar\",\n  \"area\": \"Secundaria\",\n  \"celular\": \"987654321\",\n  \"correo\": \"\",\n  \"sexo\": \"F\",\n  \"fechaIngreso\": \"2024-03-01\"\n}" }
      },
      "event": [
        { "listen": "prerequest", "script": { "exec": [
          "pm.collectionVariables.set('dni', '4' + String(Math.floor(Math.random() * 1e7)).padStart(7, '0'));"
        ] } },
        { "listen": "test", "script": { "exec": [
          "pm.test('201 creado activo', () => { pm.response.to.have.status(201); pm.expect(pm.response.json().estado).to.eql('A'); });",
          "pm.collectionVariables.set('personalId', pm.response.json().id);"
        ] } }
      ]
    },
    {
      "name": "GET Listar personal",
      "request": { "method": "GET", "url": "{{baseUrl}}/personal" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('200 con lista', () => { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.be.an('array').that.is.not.empty; });"
      ] } }]
    },
    {
      "name": "GET Listar personal Estado",
      "request": { "method": "GET", "url": "{{baseUrl}}/personal/estado/A" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('solo activos', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().every(p => p.estado === 'A')).to.be.true; });"
      ] } }]
    },
    {
      "name": "GET Listar personal ID",
      "request": { "method": "GET", "url": "{{baseUrl}}/personal/{{personalId}}" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('200 el creado', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().dni).to.eql(pm.collectionVariables.get('dni')); });"
      ] } }]
    },
    {
      "name": "PUT Editar personal",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/personal/{{personalId}}",
        "body": { "mode": "raw", "raw": "{\n  \"nombres\": \"Rosa María\",\n  \"apellidos\": \"Quispe Torres\",\n  \"dni\": \"{{dni}}\",\n  \"cargo\": \"Administrativo\",\n  \"area\": \"Secretaría\",\n  \"celular\": \"987654321\",\n  \"correo\": \"\",\n  \"sexo\": \"F\",\n  \"fechaIngreso\": \"2024-03-01\"\n}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('200 editado', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().cargo).to.eql('Administrativo'); pm.expect(pm.response.json().updatedAt).to.exist; });"
      ] } }]
    },
    {
      "name": "PATCH Eliminar Logico personal",
      "request": { "method": "PATCH", "url": "{{baseUrl}}/personal/eliminar/{{personalId}}" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('estado I', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().estado).to.eql('I'); pm.expect(pm.response.json().deletedAt).to.exist; });"
      ] } }]
    },
    {
      "name": "PATCH Restaurar Logico personal",
      "request": { "method": "PATCH", "url": "{{baseUrl}}/personal/restaurar/{{personalId}}" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('estado A', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().estado).to.eql('A'); pm.expect(pm.response.json().restoredAt).to.exist; });"
      ] } }]
    }
  ]
}
